rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasActiveMembership() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.active == true;
    }

    function isMember() {
      return hasActiveMembership();
    }

    // ─── Public data ──────────────────────────────────────────────────────────

    // Shows: public can read public shows; only admins can write
    match /shows/{showId} {
      allow read: if resource.data.isPublic == true || isMember();
      allow create, update, delete: if isAdmin();
    }

    // Merch: public read; admin write
    match /merch/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media: public read; admin write
    match /media/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages: the public form posts to /api/contact, which validates,
    // throttles per IP, and writes with the Admin SDK. Nothing legitimate writes
    // here from a browser, so client writes are closed — an open `create: true`
    // let anyone skip the throttle and fill the collection straight from a
    // console.
    match /contactMessages/{msgId} {
      allow create: if false; // Admin SDK only, via /api/contact
      allow read, update, delete: if isMember();
    }

    // ─── Private / member-only ────────────────────────────────────────────────

    // Memberships: only server-side (admin SDK) can write
    // Members can read their own doc; admins can read all
    match /memberships/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if false; // Server-side only via Admin SDK
    }

    // Availabilities: members manage their own; all members can read all
    match /availabilities/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid;
      allow delete: if isAdmin() || (isMember() && request.auth.uid == uid);
    }

    // Set lists: all members read/write; no public access
    match /setlists/{setlistId} {
      allow read, write: if isMember();
    }

    // Opportunities: all members read/write; no public access
    match /opportunities/{oppId} {
      allow read, write: if isMember();
    }

    // Outreach drafts: all members read/write
    match /outreachDrafts/{draftId} {
      allow read, write: if isMember();
    }

    // Users collection: own doc only
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Site content (bio, tagline, etc): admins write; members read
    match /siteContent/{docId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Subscribers: same shape as contact messages. /api/subscribe validates the
    // address, upserts by email, and is throttled per IP. The old
    // `create, update: if true` additionally allowed overwriting an existing
    // subscriber's record from a browser.
    match /subscribers/{email} {
      allow create, update: if false; // Admin SDK only, via /api/subscribe
      allow read, delete: if false;
    }

    // Ticket orders: written by the public checkout API and read by the
    // dashboard, both through the Admin SDK. Fan names live here, so no client
    // ever touches this collection directly.
    match /ticketOrders/{orderId} {
      allow read, write: if false; // Admin SDK only
    }

    // Pending invitations: server-side only
    match /pendingInvitations/{email} {
      allow read, write: if false; // Admin SDK only
    }

    // Activity log: members read + append entries as themselves; immutable
    match /activityLog/{entryId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
